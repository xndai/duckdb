# name: test/sql/function/string/test_trim_characters.test
# description: LTRIM/RTRIM/TRIM with an explicit set of characters
# group: [string]

statement ok
CREATE TABLE strings(s VARCHAR, chars VARCHAR)

statement ok
INSERT INTO strings VALUES
	('  hello  ', ' '),
	('xxhelloyy', 'xy'),
	('', ' '),
	('     ', ' '),
	(NULL, ' '),
	('  hello  ', NULL),
	('  hello  ', ''),
	('  a long string that is not inlined     ', ' '),
	('                ahello world         ', ' a'),
	('aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaa'),
	('éé héllo éé', ' é'),
	('　 hello 　', '　'),
	('　 hello 　', ' 　'),
	('ééxhelloxéé', 'x'),
	('x🦆x🦆', 'x🦆'),
	('🦆hello🦆', '🦆')

# constant ASCII trim set
query III
SELECT '[' || LTRIM(s, ' ') || ']', '[' || RTRIM(s, ' ') || ']', '[' || TRIM(s, ' ') || ']' FROM strings
